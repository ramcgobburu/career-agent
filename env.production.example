ENVIRONMENT=production
OPENAI_API_KEY=your_openai_api_key

# Supabase (database + auth)
# IMPORTANT: Use Session Pooler (port 6543) for Render compatibility (IPv4)
# Get the connection string from Supabase Dashboard > Settings > Database > Connection Pooling
# 
# For Session Mode (recommended for Render):
#   - Port: 6543
#   - Username: postgres.qiigwshlzdlvddcaknyp (with project ref)
#   - Format: postgresql://postgres.qiigwshlzdlvddcaknyp:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require
#
# For Transaction Mode (port 5432) - may have IPv4/IPv6 issues on Render:
#   - Port: 5432
#   - Username: postgres.qiigwshlzdlvddcaknyp (with project ref)
#   - Format: postgresql://postgres.qiigwshlzdlvddcaknyp:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
#
# Note: URL-encode special characters in password (@ -> %40, # -> %23, etc.)
# Example password "Careeragnet@123#" becomes "Careeragnet%40123%23"
DATABASE_URL=postgresql://postgres.qiigwshlzdlvddcaknyp:YOUR_PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://qiigwshlzdlvddcaknyp.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe (optional until monetization is enabled)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Domain configuration
CORS_ORIGINS=https://careerpilotconsulting.com,https://www.careerpilotconsulting.com
ALLOWED_HOSTS=careerpilotconsulting.com,*.careerpilotconsulting.com
PORT=8000


